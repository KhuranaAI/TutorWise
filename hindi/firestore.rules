rules_version = '2';
// Bolo! cloud save. Paste into Firebase console → Firestore Database → Rules → Publish.
// A save can only be opened by its exact save code; nobody can list or browse saves.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{code} {
      allow get: if code.matches('^[A-Z0-9-]{10,40}$');
      allow list, delete: if false;
      allow create, update: if code.matches('^[A-Z0-9-]{10,40}$')
        && request.resource.data.keys().hasOnly(['data', 'savedAt', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000
        && request.resource.data.savedAt is int
        && request.resource.data.v is int;
    }
  }
}
